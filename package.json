{
  "name": "helfio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx server/index.ts",
    "db:migrate": "psql \"$DATABASE_URL\" -f db/migrations/001_create_categories.sql",
    "db:seed": "psql \"$DATABASE_URL\" -f db/seed.sql",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck:backend": "tsc -p tsconfig.server.json --noEmit",
    "test:backend": "tsx --test server/**/*.test.ts"
  },
  "dependencies": {
    "pg": "^8.16.3",
    "vue": "^3.5.42",
    "vue-i18n": "^11.4.10"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pg": "^8.15.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "tsx": "^4.20.6",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.11"
  }
}
